# ============================================================
# BorderScan — Environment Variable Reference
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Google Gemini API ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Server ---
PORT=3001
NODE_ENV=development

# --- Database ---
DATABASE_PATH=./database.sqlite

# --- CBP Data ---
# Official CBP Border Wait Times API
CBP_API_BASE_URL=https://bwt.cbp.gov/api
CBP_API_KEY=your_cbp_api_key_here

# --- Holiday API ---
# e.g. Calendarific or Nager.Date
HOLIDAY_API_BASE_URL=https://date.nager.at/api/v3
HOLIDAY_API_KEY=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:3001/api
VITE_SHOW_DEBUG=false

# --- CBP Environment Switches ---
CBP_USE_MOCK=false
CBP_ALLOW_FALLBACK=true
CBP_DEBUG=true
